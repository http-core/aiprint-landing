# Telegram-бот, через которого заявки с сайта приходят в чат.
# Без этих переменных форма честно показывает «приём заявок не настроен».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 — брать IP клиента из X-Forwarded-For (только если сайт за вашим nginx/прокси).
TRUST_PROXY=0

# Адрес сайта для canonical/OG (необязательно), напр. https://example.ru
SITE_URL=

# Порт/хост Node-сервера
HOST=0.0.0.0
PORT=4321
