---
import Base from '../layouts/Base.astro';
import Footer from '../components/ui/Footer.astro';
import { phAttr, site, val } from '../data';

const { privacy } = site;
---

<Base title={`Политика конфиденциальности — ${site.brand}`} description="Политика обработки персональных данных">
  <main id="main" class="legal container">
    <a class="legal__back" href="/">← На главную</a>
    <h1 class="legal__title">Политика обработки персональных данных</h1>
    <p class="legal__operator">
      Оператор: {site.company.name}, ОГРНИП {site.company.ogrnip}, ИНН {site.company.inn}.{' '}
      Контакт: <a href={`mailto:${site.company.email}`}>{site.company.email}</a>
    </p>
    <div class="legal__body" {...phAttr(privacy.body)}>
      {val(privacy.body).map((p) => <p>{p}</p>)}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 820px;
    padding-block: 48px 96px;
  }

  .legal__back {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink-2);
  }

  .legal__title {
    margin-block: 24px 20px;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-head);
  }

  .legal__operator {
    color: var(--ink-2);
  }

  .legal__body {
    display: grid;
    gap: 16px;
    margin-top: 32px;
    font-size: 1.0625rem;
  }
</style>
