---
/* Объектив фотобудки — векторный, без использования фото будки.
   #lens-glare — блик, который анимируется по стеклу (сцена 1). */
const ringText = 'AI66 · NEURAL PORTRAIT LENS · 1:1.4 · ∞ · AI66 · NEURAL PORTRAIT LENS · 1:1.4 · ∞ · ';
---

<svg class="lens" viewBox="0 0 400 400" role="presentation" focusable="false">
  <defs>
    <linearGradient id="lens-bezel" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3a393c"></stop>
      <stop offset=".45" stop-color="#18181a"></stop>
      <stop offset="1" stop-color="#050506"></stop>
    </linearGradient>
    <radialGradient id="lens-glass" cx=".42" cy=".38" r=".7">
      <stop offset="0" stop-color="#4a36b8"></stop>
      <stop offset=".38" stop-color="#1b1350"></stop>
      <stop offset=".75" stop-color="#08061a"></stop>
      <stop offset="1" stop-color="#020205"></stop>
    </radialGradient>
    <linearGradient id="lens-glare-grad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset=".5" stop-color="#fff" stop-opacity=".75"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <clipPath id="lens-glass-clip"><circle cx="200" cy="200" r="118"></circle></clipPath>
    <path id="lens-ring-path" d="M200 200 m-159 0 a159 159 0 1 1 318 0 a159 159 0 1 1 -318 0"></path>
  </defs>

  <circle cx="200" cy="200" r="198" fill="url(#lens-bezel)"></circle>
  <circle cx="200" cy="200" r="183" fill="none" stroke="#2c2c2f" stroke-width="16" stroke-dasharray="1.6 3.2"></circle>
  <circle cx="200" cy="200" r="174" fill="none" stroke="#000" stroke-opacity=".6" stroke-width="2"></circle>
  <text font-family="ui-monospace, Menlo, monospace" font-size="10.5" letter-spacing="2.4" fill="#8f8b82">
    <textPath href="#lens-ring-path">{ringText}</textPath>
  </text>
  <circle cx="200" cy="200" r="142" fill="#0b0b0c" stroke="#232325" stroke-width="5"></circle>
  <circle cx="200" cy="200" r="128" fill="none" stroke="#c8f04a" stroke-opacity=".5" stroke-width="1.2"></circle>

  <g clip-path="url(#lens-glass-clip)">
    <circle cx="200" cy="200" r="118" fill="url(#lens-glass)"></circle>
    <polygon
      points="200,150 243,175 243,225 200,250 157,225 157,175"
      fill="#030306"
      stroke="#2a2266"
      stroke-width="2"></polygon>
    <path d="M128 168 A 76 76 0 0 1 166 128" fill="none" stroke="#c8f04a" stroke-opacity=".5" stroke-width="4" stroke-linecap="round"></path>
    <path d="M262 246 A 72 72 0 0 1 236 268" fill="none" stroke="#ff6b57" stroke-opacity=".55" stroke-width="4" stroke-linecap="round"></path>
    <ellipse cx="160" cy="152" rx="34" ry="15" fill="#fff" opacity=".24" transform="rotate(-35 160 152)"></ellipse>
    <circle cx="244" cy="246" r="7" fill="#fff" opacity=".18"></circle>
    <rect id="lens-glare" x="-260" y="40" width="120" height="320" fill="url(#lens-glare-grad)" transform="rotate(24 200 200)"></rect>
  </g>
</svg>

<style>
  .lens {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 30px 40px rgb(20 20 20 / 0.28));
  }
</style>
