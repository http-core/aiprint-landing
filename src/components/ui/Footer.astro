---
import { site, val } from '../../data';
const contact = val(site.telegramContact);
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="footer__brand">{site.brand}</p>
    <ul class="footer__links">
      <li><a href={`https://t.me/${contact}`} target="_blank" rel="noopener">Telegram · @{contact}</a></li>
      <li><a href={`mailto:${site.company.email}`}>{site.company.email}</a></li>
      <li><a href="/privacy">Политика конфиденциальности</a></li>
    </ul>
    <p class="footer__legal">
      © {new Date().getFullYear()} {site.company.name}<span aria-hidden="true"> · </span><br class="footer__br" />ОГРНИП {site.company.ogrnip} · ИНН {site.company.inn}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 40px;
    background: var(--ink);
    color: var(--bg);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }

  .footer__brand {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: rgb(244 245 247 / 0.78);
    text-underline-offset: 4px;
  }

  .footer__links a:hover {
    color: var(--lime);
  }

  .footer__legal {
    flex-basis: 100%;
    padding-top: 16px;
    border-top: 1px solid rgb(244 245 247 / 0.12);
    font-size: var(--fs-small);
    color: rgb(244 245 247 / 0.62);
  }

  .footer__br {
    display: none;
  }

  @media (max-width: 559px) {
    .footer__legal span {
      display: none;
    }

    .footer__br {
      display: inline;
    }
  }
</style>
