---
import type { HTMLAttributes } from 'astro/types';

/* Кнопка-ссылка (CTA). Кнопка отправки формы описана в самой форме. */
type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'primary' | 'ghost';
};
const { href, variant = 'primary', class: cls, ...rest } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, cls]} {...rest}>
  <span class="btn__label"><slot /></span>
  <span class="btn__icon" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </span>
</a>

<style is:global>
  .btn {
    --btn-bg: var(--ink);
    --btn-fg: var(--milk);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 56px;
    padding: 0 10px 0 26px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .btn__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .btn:hover .btn__icon {
    transform: translateX(3px) rotate(-45deg);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-fg: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .btn--ghost:hover {
    --btn-bg: var(--paper);
  }

  .btn--primary:hover {
    --btn-bg: #000;
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.75;
  }
</style>
